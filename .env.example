MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=production
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ---- Pronunciation engines (auto ladder: azure → whisper → browser-asr → local) ----
# PRONUNCIATION_PROVIDER: auto | azure | whisper | browser | local
PRONUNCIATION_PROVIDER=auto
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_SPEECH_LANGUAGE=en-US
# Self-hosted Whisper-compatible ASR (multipart file=... → JSON {text|transcript})
WHISPER_ASR_URL=
WHISPER_ASR_TOKEN=
# 作业语音默认不采信浏览器 transcript（防粘贴刷分）；自由练习仍可用。设为 1 可放开
PRONUNCIATION_TRUST_BROWSER_ASR=0
# 上传下载是否要求登录（默认 0，兼容 audio 标签直链）
UPLOAD_REQUIRE_AUTH=0

# ---- Shared uploads (required for multi-replica API) ----
# STORAGE_BACKEND: local | s3 | minio | oss
STORAGE_BACKEND=local
# 默认仓库根下 uploads/、asset/、frontend/；Compose 内分别为 /srv/uploads、/srv/asset
UPLOAD_DIR=
ASSET_DIR=
FRONTEND_DIR=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional CDN/public base; if empty and S3_PRESIGN=1, API redirects with presigned URL
S3_PUBLIC_BASE_URL=
S3_PRESIGN=1

# ---- Parent / teacher push (inbox always on) ----
NOTIFY_WEBHOOK_URL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ID=
WECHAT_DEFAULT_URL=
# Optional template data map, e.g. {"thing1":"{title}","thing2":"{body}"}
WECHAT_TEMPLATE_DATA_JSON=
